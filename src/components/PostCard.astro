---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

const dateFormatted = new Date(post.data.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/post/${post.id}`} class="card post-card">
  <div class="post-card-top">
    {post.data.categorias?.[0] && <span class="cat-tag">{post.data.categorias[0]}</span>}
    <time datetime={post.data.date.toISOString()}>{dateFormatted}</time>
  </div>
  <p class="post-title">{post.data.title}</p>
</a>
