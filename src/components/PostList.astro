---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  featured?: boolean;
}

const { posts, featured = false } = Astro.props;

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
const readMin = (entry: { body?: string }) =>
  Math.max(1, Math.round((entry.body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));

const [first, ...others] = posts;
const head = featured ? first : undefined;
const rest = featured ? others : posts;
---

<div class="post-list">
  {head && (
    <a class="feat-card" href={`/post/${head.id}`}>
      <div class="feat-meta">último artigo · {fmt(head.data.date)} · ~{readMin(head)} min</div>
      <h3 class="feat-title">{head.data.title}</h3>
      {head.data.description && <p class="feat-desc">{head.data.description}</p>}
      <div class="feat-foot">
        {head.data.categorias?.[0] && <span class="mini-tag">{head.data.categorias[0]}</span>}
        <span class="feat-cta">ler →</span>
      </div>
    </a>
  )}

  <div class="rows">
    {rest.map((post) => (
      <a class="row" href={`/post/${post.id}`}>
        <span class="row-date">{fmt(post.data.date)}</span>
        <span class="row-main">
          <span class="row-title">{post.data.title}</span>
          {post.data.categorias?.[0] && <span class="row-tag">{post.data.categorias[0]}</span>}
        </span>
        <span class="row-arrow">→</span>
      </a>
    ))}
  </div>
</div>

<style>
  .feat-card {
    display: block;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 28px 28px;
    color: var(--text-strong);
    text-decoration: none;
    margin-bottom: 34px;
    transition: border-color 0.15s;
  }
  .feat-card:hover { border-color: var(--text-strong); text-decoration: none; }
  .feat-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .feat-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 680px;
    text-wrap: pretty;
    color: var(--text-strong);
    margin-bottom: 10px;
  }
  .feat-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 640px;
    margin-bottom: 18px;
  }
  .feat-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .mini-tag {
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    color: var(--text-body);
  }
  .feat-cta { margin-left: auto; color: var(--text-strong); font-weight: 700; text-decoration: underline; text-decoration-color: var(--border-subtle); text-underline-offset: 3px; }

  .rows { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 20px 6px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-strong);
    text-decoration: none;
    transition: background 0.15s;
  }
  .row:hover { background: var(--surface-highlight); text-decoration: none; }
  .row-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .row-main { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .row-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .row-tag { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .row-arrow { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); }
  .row:hover .row-arrow { color: var(--text-strong); }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; gap: 12px; }
    .row-date { grid-column: 1 / -1; }
    .feat-card { padding: 22px 20px; }
    .feat-title { font-size: 22px; }
  }
</style>
