---
const year = new Date().getFullYear();
---

<footer class="botbar" aria-label="Rodapé">
  <div class="bb-in">
    <span class="bb-copy">© {year} · <a href="/sobre">Mateus Roveda</a></span>
    <span class="bb-comm">
      <b>comunidade</b>
      <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer">YouTube ↗</a>
      <a href="https://t.me/roveeb" target="_blank" rel="noopener noreferrer">Telegram ↗</a>
      <a href="https://github.com/mateusrovedaa" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </span>
  </div>
</footer>

<style>
  .botbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    height: var(--footerbar-h, 32px);
    background: var(--chrome-bg);
    border-top: 1px solid var(--chrome-line);
    display: flex;
    align-items: center;
  }

  .bb-in {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .bb-copy {
    color: rgba(178, 228, 255, 0.74);
    white-space: nowrap;
  }
  .bb-copy a {
    color: rgba(178, 228, 255, 0.88);
    text-decoration: none;
  }
  .bb-copy a:hover { color: var(--color-primary); }

  .bb-comm {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    white-space: nowrap;
  }
  .bb-comm b {
    color: rgba(178, 228, 255, 0.64);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.62rem;
  }
  .bb-comm a {
    color: rgba(178, 228, 255, 0.85);
    text-decoration: none;
    transition: color 0.15s;
  }
  .bb-comm a:hover { color: var(--color-primary); }

  @media (max-width: 560px) {
    .bb-in {
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      font-size: 0.66rem;
      text-align: center;
    }
    .bb-comm { gap: var(--space-sm); }
    .bb-comm b { display: none; }
  }
</style>
