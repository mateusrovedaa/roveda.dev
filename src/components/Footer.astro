---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <!-- Light: R em preto -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-light">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#0A0A0A" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#0A0A0A"></circle>
        <circle cx="32" cy="86" r="9" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="6"></circle>
      </svg>
      <!-- Dark: R em cinza claro -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-dark">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#EDEDED" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#EDEDED"></circle>
        <circle cx="32" cy="86" r="9" fill="#0A0A0A" stroke="#EDEDED" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#0A0A0A" stroke="#EDEDED" stroke-width="6"></circle>
      </svg>
      <span>© {year} Mateus Roveda · conteúdo sob CC BY-SA</span>
    </div>
    <span class="footer-right">feito com software livre</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
    background: var(--surface-page);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-body);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-mark {
    flex: none;
  }
  .mark-dark { display: none; }
  :global(html[data-theme='dark']) .mark-light { display: none; }
  :global(html[data-theme='dark']) .mark-dark { display: block; }

  .footer-right {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      padding: 24px 16px;
      gap: 8px;
    }
  }
</style>
