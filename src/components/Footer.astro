---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <!-- Light: R navio escuro -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-light">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#061736" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#061736"></circle>
        <circle cx="32" cy="86" r="9" fill="#FCFFFE" stroke="#061736" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#FCFFFE" stroke="#077E7D" stroke-width="6"></circle>
      </svg>
      <!-- Dark: R mint -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-dark">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#92FDEF" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#92FDEF"></circle>
        <circle cx="32" cy="86" r="9" fill="#061736" stroke="#92FDEF" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#061736" stroke="#EFFEFC" stroke-width="6"></circle>
      </svg>
      <span>© {year} Mateus Roveda · conteúdo sob CC BY-SA</span>
    </div>
    <span class="footer-right">feito com software livre</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
    background: var(--surface-page);
  }
  :global(html[data-theme='dark']) .site-footer {
    background: #061736;
    border-top-color: rgba(146, 253, 239, 0.12);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  :global(html[data-theme='dark']) .footer-inner {
    color: rgba(239,254,252,0.62);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-mark {
    flex: none;
  }
  .mark-dark { display: none; }
  :global(html[data-theme='dark']) .mark-light { display: none; }
  :global(html[data-theme='dark']) .mark-dark { display: block; }

  .footer-right {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      padding: 24px 16px;
      gap: 8px;
    }
  }
</style>
