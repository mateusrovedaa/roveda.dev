---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <!-- Light: simbolo-claro (R navio #061736 em fundo claro) -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-light">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#061736" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#061736"></circle>
        <circle cx="32" cy="86" r="9" fill="#FCFFFE" stroke="#061736" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#FCFFFE" stroke="#077E7D" stroke-width="6"></circle>
      </svg>
      <!-- Dark: simbolo-navio (R mint #92FDEF em fundo navio) -->
      <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="footer-mark mark-dark">
        <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#92FDEF" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="71" cy="31" r="8.5" fill="#92FDEF"></circle>
        <circle cx="32" cy="86" r="9" fill="#061736" stroke="#92FDEF" stroke-width="6"></circle>
        <circle cx="72" cy="86" r="9" fill="#061736" stroke="#EFFEFC" stroke-width="6"></circle>
      </svg>
      <span>© {year} Mateus Roveda · conteúdo sob CC BY-SA</span>
    </div>
    <div class="footer-right">
      <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer" class="footer-youtube">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <rect x="1" y="5" width="22" height="14" rx="4" fill="currentColor"></rect>
          <path d="M10 9 L16 12 L10 15 Z" fill="var(--surface-page)"></path>
        </svg>
        <span>youtube.com/ROVEEb</span>
      </a>
      <span class="footer-tagline">liberdade de conhecimentos</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
    background: var(--surface-page);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-body);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-mark {
    flex: none;
  }
  .mark-dark { display: none; }
  :global(html[data-theme='dark']) .mark-light { display: none; }
  :global(html[data-theme='dark']) .mark-dark { display: block; }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
  }

  .footer-tagline {
    color: var(--text-muted);
  }

  .footer-youtube {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    color: var(--text-body);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .footer-youtube:hover {
    border-color: var(--text-strong);
    color: var(--text-strong);
    background: var(--surface-raised);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      padding: 24px 16px;
      gap: 14px;
    }
    .footer-right { flex-direction: column; gap: 10px; }
  }
</style>
