---
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/mateusrovedaa' },
  { label: 'GitLab', href: 'https://gitlab.com/mateusrovedaa' },
  { label: 'YouTube', href: 'https://youtube.com/ROVEEb' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mateusrovedaa/' },
  { label: 'Twitter', href: 'https://twitter.com/mateusrovedaa' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="community">
      <p class="community-title">Faça parte da comunidade</p>
      <div class="community-links">
        <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer" class="community-link youtube">
          YouTube · ROVEEb
        </a>
        <a href="https://t.me/roveeb" target="_blank" rel="noopener noreferrer" class="community-link telegram">
          Telegram · @roveeb
        </a>
      </div>
    </div>

    <div class="bottom">
      <a href="/" class="footer-logo" aria-label="ROVEEb — página inicial">
        <img src="/logo.png" alt="ROVEEb" class="footer-logo-img" width="1152" height="418" />
      </a>
      <nav aria-label="Redes sociais">
        <ul>
          {socialLinks.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="copyright">
        © {new Date().getFullYear()} Mateus Roveda
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark);
    color: var(--color-blue-light);
    margin-top: auto;
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .community {
    border-top: 1px solid var(--color-teal-dark);
    padding-top: var(--space-lg);
  }

  .community-title {
    font-weight: var(--font-weight-bold);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-light);
    margin-bottom: var(--space-md);
  }

  .community-links {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .community-link {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-bold);
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .community-link:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .community-link.youtube {
    background-color: #dc0000;
    color: #fff;
  }

  .community-link.telegram {
    background-color: var(--color-primary);
    color: var(--color-dark);
  }

  .footer-logo {
    display: flex;
    align-items: center;
  }

  .footer-logo-img {
    height: 32px;
    width: auto;
    display: block;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .footer-logo:hover .footer-logo-img {
    opacity: 1;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  nav a {
    color: var(--color-gray-light);
    font-size: 0.85rem;
    font-weight: var(--font-weight-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .copyright {
    font-size: 0.8rem;
    font-weight: var(--font-weight-light);
    color: var(--color-gray-light);
  }
</style>
