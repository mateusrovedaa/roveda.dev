---
// Usa a Default UI do Pagefind (assets gerados pela integração astro-pagefind no build).
// Carregada sob demanda na primeira abertura do modal.
---

<button type="button" class="search-trigger" aria-label="Buscar" data-search-open>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-trigger-label">Buscar</span>
  <kbd data-search-kbd>Ctrl K</kbd>
</button>

<dialog class="search-dialog" data-search-dialog>
  <div class="search-dialog-inner">
    <div id="pagefind-ui"></div>
  </div>
</dialog>

<script is:inline>
  (function () {
    let initialized = false;
    const dialog = document.querySelector('[data-search-dialog]');
    const openBtn = document.querySelector('[data-search-open]');

    function focusInput() {
      requestAnimationFrame(() => dialog?.querySelector('input')?.focus());
    }

    function initPagefind() {
      if (initialized) return;
      initialized = true;

      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);

      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = function () {
        new window.PagefindUI({
          element: '#pagefind-ui',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: 'Buscar posts e páginas…',
            zero_results: 'Nenhum resultado para "[SEARCH_TERM]"',
          },
        });
        focusInput();
      };
      script.onerror = function () {
        const el = document.getElementById('pagefind-ui');
        if (el) el.textContent = 'Índice de busca indisponível. Rode "pnpm build" para gerá-lo.';
      };
      document.head.appendChild(script);
    }

    function openSearch() {
      initPagefind();
      dialog?.showModal();
      focusInput();
    }

    openBtn?.addEventListener('click', openSearch);

    document.addEventListener('keydown', function (e) {
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        openSearch();
        return;
      }
      const tag = e.target && e.target.tagName;
      const isEditable = e.target && e.target.isContentEditable;
      if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && !isEditable) {
        e.preventDefault();
        openSearch();
      }
    });

    // Clique no backdrop fecha
    dialog?.addEventListener('click', function (e) {
      if (e.target === dialog) dialog.close();
    });

    const kbdEl = document.querySelector('[data-search-kbd]');
    const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent || '');
    if (kbdEl && isMac) kbdEl.textContent = '⌘K';
  })();
</script>

<style is:global>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 6px 10px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--text-body);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .search-trigger:hover,
  .search-trigger:focus-visible {
    background: var(--surface-raised);
    border-color: var(--border-control);
    color: var(--text-strong);
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--surface-page);
    border: 1px solid var(--border-control);
    border-radius: 3px;
    padding: 0 5px;
    color: var(--text-body);
  }

  .search-dialog {
    width: min(640px, 92vw);
    max-height: 80vh;
    margin: 9vh auto auto;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
  }

  .search-dialog-inner {
    padding: var(--space-lg);
    max-height: 80vh;
    overflow-y: auto;
  }

  /* Pagefind Default UI - alinhamento com o design system */
  #pagefind-ui {
    --pagefind-ui-primary: var(--text-strong);
    --pagefind-ui-text: var(--text-strong);
    --pagefind-ui-background: var(--surface-card);
    --pagefind-ui-border: var(--border-card);
    --pagefind-ui-tag: var(--surface-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-sans);
  }

  /* Botão "Limpar" - só aparência; mantém a geometria default do Pagefind
     (top/height fixos), pois o form envolve input + resultados e esticar
     com bottom:0 viraria uma faixa vertical. */
  #pagefind-ui .pagefind-ui__search-clear {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s, background 0.15s;
  }

  #pagefind-ui .pagefind-ui__search-clear:hover {
    color: var(--text-strong);
    background: var(--surface-raised);
  }

  @media (max-width: 600px) {
    .search-trigger-label,
    .search-trigger kbd {
      display: none;
    }
  }
</style>
