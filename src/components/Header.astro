---
import Search from './Search.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Posts', href: '/posts' },
  { label: 'Tutoriais', href: '/tutoriais' },
  { label: 'Projetos', href: '/projetos' },
  { label: 'Sobre', href: '/sobre' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label="ROVEEb — blog de Mateus Roveda, página inicial">
      <img src="/logo.png" alt="ROVEEb" class="logo-img" width="1152" height="418" />
      <span class="logo-byline">por <strong>Mateus Roveda</strong></span>
    </a>
    <nav aria-label="Navegação principal">
      <ul>
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Alternar tema claro e escuro" title="Alternar tema">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>
    <Search />
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-dark);
    padding: var(--space-md) 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
  }

  /* logo à esquerda, nav + busca empurrados para a direita */
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    margin-right: auto;
  }

  .logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  /* tagline de marca: deixa claro que ROVEEb é o blog de Mateus Roveda */
  .logo-byline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-blue-light);
    border-left: 1px solid var(--color-teal-mid);
    padding-left: var(--space-sm);
  }

  .logo-byline strong {
    display: block;
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
  }

  /* botão de tema — geometria/cores alinhadas ao .search-trigger */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(65, 186, 255, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-blue-light);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .theme-toggle svg { display: block; }
  .theme-toggle .icon-sun { display: none; }

  :global(html[data-theme='dark']) .theme-toggle .icon-moon { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .icon-sun { display: block; }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .nav-link {
    color: var(--color-blue-light);
    font-weight: var(--font-weight-light);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    /* linha 1: logo + busca · linha 2: menu (full width) */
    .container {
      gap: var(--space-sm) var(--space-md);
    }

    /* nome já aparece no hero/footer/sobre — esconde aqui p/ não apertar a linha */
    .logo-byline {
      display: none;
    }

    nav {
      order: 3;
      flex-basis: 100%;
    }

    nav ul {
      gap: var(--space-md);
    }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      root.style.setProperty('color-scheme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#0a1622' : '#0d1f2d');
    });
  })();
</script>
