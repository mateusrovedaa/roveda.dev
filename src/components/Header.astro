---
import Search from './Search.astro';

const navLinks = [
  { label: 'Início', href: '/' },
  { label: 'Posts', href: '/posts' },
  { label: 'Tutoriais', href: '/tutoriais' },
  { label: 'Projetos', href: '/projetos' },
  { label: 'Sobre', href: '/sobre' },
];

const currentPath = Astro.url.pathname;

// Breadcrumb estilo terminal (~ / posts / slug.md), derivado da rota
const seg = currentPath.replace(/\/+$/, '').split('/').filter(Boolean);
let crumb: string[];
let caption = '';
if (seg.length === 0) {
  crumb = ['home'];
  caption = 'liberdade de conhecimentos · est. 2020';
} else if (seg[0] === 'post' && seg[1]) {
  crumb = ['posts', `${seg[1]}.md`];
} else {
  crumb = [seg[seg.length - 1]];
}
---

<div class="topbar">
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo" aria-label="ROVEEb — página inicial">
        <img src="/logo.png" alt="ROVEEb" class="logo-img" width="1152" height="418" />
      </a>
      <nav aria-label="Navegação principal">
        <ul>
          {navLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class:list={['nav-link', { active: currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Alternar tema claro e escuro" title="Alternar tema">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
      <Search />
    </div>
  </header>

  <div class="pathbar">
    <div class="pb-in">
      <span class="pb-path">
        <span class="tilde">~</span>
        {crumb.map((c, i) => (
          <>
            <span class="sep">/</span>
            <span class:list={['crumb', { leaf: i === crumb.length - 1 }]}>{c}</span>
          </>
        ))}
      </span>
      {caption && <span class="pb-cap">{caption}</span>}
    </div>
  </div>
</div>

<style>
  /* Sticky: fica no fluxo (sem padding-top no body) e gruda no topo ao rolar.
     Robusto no mobile mesmo com o nav quebrando linha (altura variável). */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header {
    background-color: var(--chrome-bg);
    border-bottom: 2px solid var(--color-primary);
    padding: 0.9rem 0;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-right: auto;
  }

  .logo-img {
    height: 32px;
    width: 88px; /* 1152:418 ≈ 2.756 · evita reflow (CLS) por imagem sem dimensão */
    display: block;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .nav-link {
    font-family: var(--font-mono);
    color: rgba(178, 228, 255, 0.72);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.18s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* botão de tema */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(65, 186, 255, 0.22);
    border-radius: var(--radius-sm);
    color: rgba(178, 228, 255, 0.8);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .theme-toggle svg { display: block; }
  .theme-toggle .icon-sun { display: none; }

  :global(html[data-theme='dark']) .theme-toggle .icon-moon { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .icon-sun { display: block; }

  /* Breadcrumb */
  .pathbar {
    background: var(--surface-card);
    border-bottom: 1px solid var(--border-subtle);
  }

  .pb-in {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.55rem var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .pb-path { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pb-path .tilde { color: var(--accent); }
  .pb-path .sep { color: var(--accent); margin: 0 0.4em; }
  .pb-path .crumb.leaf { color: var(--text-strong); }
  .pb-cap { flex-shrink: 0; }

  @media (max-width: 600px) {
    /* linha 1: logo + toggle + busca · linha 2: menu (largura total) */
    .container { row-gap: 0.85rem; }

    nav {
      order: 3;
      flex-basis: 100%;
      border-top: 1px solid var(--chrome-line);
      padding-top: 0.85rem;
    }
    /* links distribuídos uniformemente de ponta a ponta */
    nav ul {
      width: 100%;
      justify-content: space-between;
      gap: var(--space-sm);
    }
    .nav-link { font-size: 0.7rem; letter-spacing: 0.06em; }

    .pb-cap { display: none; }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      root.style.setProperty('color-scheme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#0a1622' : '#0d1f2d');
    });
  })();
</script>
