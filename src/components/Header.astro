---
import Search from './Search.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Posts', href: '/posts' },
  { label: 'Tutoriais', href: '/tutoriais' },
  { label: 'Projetos', href: '/projetos' },
  { label: 'Sobre', href: '/sobre' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label="ROVEEb — página inicial">
      <img src="/logo.png" alt="ROVEEb" class="logo-img" width="1152" height="418" />
    </a>
    <nav aria-label="Navegação principal">
      <ul>
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Search />
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-dark);
    padding: var(--space-md) 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
  }

  /* logo à esquerda, nav + busca empurrados para a direita */
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-right: auto;
  }

  .logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .nav-link {
    color: var(--color-blue-light);
    font-weight: var(--font-weight-light);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    /* linha 1: logo + busca · linha 2: menu (full width) */
    .container {
      gap: var(--space-sm) var(--space-md);
    }

    nav {
      order: 3;
      flex-basis: 100%;
    }

    nav ul {
      gap: var(--space-md);
    }
  }
</style>
