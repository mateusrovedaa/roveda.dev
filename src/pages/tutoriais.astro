---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('posts', ({ data }) => {
  if (data.draft) return false;
  return data.categorias?.some((cat) => cat.toLowerCase() === 'tutoriais') ?? false;
});

const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Tutoriais" description="Tutoriais práticos que escrevo sobre Linux, redes e DevOps">
  <PageHeader
    eyebrow="~/tutoriais"
    title="Tutoriais"
    subtitle="Guias práticos que escrevo para resolver problemas reais: Linux, redes, automação e ferramentas que uso no dia a dia."
  />
  <PostList posts={posts} />
</BaseLayout>
