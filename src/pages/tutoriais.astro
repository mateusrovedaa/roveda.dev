---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => {
  if (data.draft) return false;
  return data.categorias?.some((cat) => cat.toLowerCase() === 'tutoriais') ?? false;
});

const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Tutoriais" description="Tutoriais de tecnologia, Linux e software livre">
  <PageHeader
    eyebrow="passo a passo"
    title="Tutoriais"
    subtitle="Guias práticos de Linux, redes, automação e ferramentas de DevOps."
  />
  <div class="posts-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
