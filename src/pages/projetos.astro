---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = [
  {
    id: 'pets-rs',
    name: 'Pets RS',
    url: 'https://petsrs.com.br/',
    image: '/images/uploads/petsrs.png',
    description: 'Plataforma criada em parceria com Zeno Sbardellotto Júnior e Fabrício Pretto para ajudar animais atingidos pelas enchentes de maio/2024 no RS. Reconhecida pelo Estado como plataforma oficial de reencontro de tutores e animais perdidos. Mais de 100 voluntários envolvidos.',
    media: [
      { label: 'PetsRS Dataset — UFRGS', url: 'https://lume.ufrgs.br/handle/10183/279189' },
      { label: 'GRAD — Grupo de Respostas a Animais em Desastres', url: 'https://gradbrasil.org.br/reencontro-de-animais-resgatados-com-seus-tutores-no-rio-grande-do-sul/' },
      { label: 'Governo do RS', url: 'https://www.facebook.com/GovernoDoRS/videos/a-primeira-feira-de-ado%C3%A7%C3%A3o-respons%C3%A1vel-de-c%C3%A3es-e-gatos-resgatados-nas-enchentes-/444386955067301/' },
      { label: 'Band News', url: 'https://www.youtube.com/watch?v=z1pkWx9tACQ' },
      { label: 'Terra — Site ajuda a reencontrar animais desaparecidos em todo o RS', url: 'https://terra.com.br/noticias/site-ajuda-a-reencontrar-animais-desaparecidos-em-todo-o-rs,71cd94c90bb3a50f098ce8a2ce7194e3a7qksbns.html' },
      { label: 'Canaltech — Redes sociais ajudam a encontrar animais perdidos', url: 'https://canaltech.com.br/redes-sociais/chuvas-no-rs-redes-sociais-ajudam-a-encontrar-animais-perdidos-288373/' },
      { label: 'Veja — Tutores vivem reencontros emocionantes com seus pets no RS', url: 'https://veja.abril.com.br/comportamento/tutores-vivem-reencontros-emocionantes-com-seus-pets-no-rs/' },
    ],
  },
  {
    id: 'pets-vale-do-taquari',
    name: 'Pets Vale do Taquari',
    url: 'https://petsvaledotaquari.com.br/',
    image: '/images/uploads/petsvaledotaquari.png',
    description: 'Plataforma criada em 6h para ajudar animais atingidos pelas enchentes de setembro/2023 no Vale do Taquari. Mais de 1000 seguidores no Instagram e 6000 visitantes únicos.',
    media: [
      { label: 'G1 — Ciclone no RS: ONG ajuda a reunir tutores e animais perdidos', url: 'https://g1.globo.com/rs/rio-grande-do-sul/noticia/2023/09/19/ciclone-no-rs-ong-ajuda-a-reunir-tutores-e-animais-perdidos-durante-enchentes.ghtml' },
      { label: 'Agora no Vale', url: 'https://agoranovale.com.br/noticias/valedotaquari/portal-pets-do-vale-do-taquari-ajuda-na-localizacao-de-animais-perdidos-na-enchente/' },
      { label: 'Diário Gaúcho', url: 'https://diariogaucho.clicrbs.com.br/rs/dia-a-dia/noticia/2023/09/vale-do-taquari-site-reune-pets-e-seus-donos-apos-enchentes-34130840.html' },
      { label: 'Jornal do Almoço', url: 'https://www.instagram.com/p/Cxa9N96LMht/' },
      { label: 'Rádio Gaúcha', url: 'https://soundcloud.com/radiogaucha/mateus-roveda-engenheiro-de-software-e-um-dos-idealizadores-do-pets-vale-do-taquari-20092023?si=5e261549fd8a4b289bffe8a2efec0a69&utm_source=clipboard&utm_medium=text&utm_campaign=social_sharing' },
      { label: 'Univates', url: 'https://www.univates.br/noticia/34253-professor-estudante-e-diplomado-da-univates-criam-portal-para-ajudar-na-localizacao-de-animais-perdidos-durante-enchente' },
      { label: 'Record RS TV', url: 'https://www.youtube.com/watch?v=s00s_EJ2pm4' },
      { label: 'Grupo A Hora — Em busca da solução', url: 'https://grupoahora.net.br/conteudos/2023/09/22/numero-de-animais-em-abrigos-cresce-apos-a-enchente/' },
    ],
  },
  {
    id: 'prefa',
    name: 'Prefa Digital',
    url: 'https://prefa.digital',
    image: '/images/uploads/prefadigital.png',
    description: 'Empresa com foco em soluções inteligentes para governo. Originada do TCC dos alunos Zeno Sbardellotto Júnior e Mateus Roveda, com orientação do Fabrício Pretto. Produtos: Prefa 156 e LOGI.',
    media: [
      { label: 'Univates', url: 'https://www.univates.br/noticia/33390-estudantes-criam-solucao-tecnologica-para-prefeituras' },
      { label: 'Acelera X POA', url: 'https://prefeitura.poa.br/gi/noticias/anunciadas-15-startups-selecionadas-para-o-acelera-x-poa-inovadora' },
    ],
  },
  {
    id: 'universidade-brasileira-livre',
    name: 'Universidade Brasileira Livre',
    url: 'https://ulivre.dev',
    image: '/images/uploads/ulivre.png',
    description: 'Organização sem fins lucrativos fundada em 2021 que organiza conteúdo online em português para aumentar o acesso de brasileiros à educação. Mais de 10.000 estrelas no GitHub.',
    media: [],
  },
  {
    id: 'municipiosdev',
    name: 'municipios.dev',
    url: 'https://github.com/mateusrovedaa/municipios.dev',
    image: '/images/uploads/municipiosdev.png',
    description: 'API para retornar informações do portal do IBGE e pesquisar websites de prefeituras.',
    media: [],
  },
  {
    id: 'roveeb',
    name: 'ROVEEb',
    url: 'https://youtube.com/ROVEEb',
    image: '/images/uploads/roveeb.png',
    description: 'Canal no YouTube criado em 07/03/2020, com mais de 8.000 inscritos. Conteúdo sobre tecnologia, software livre, DevOps e automação.',
    media: [],
  },
  {
    id: 'sorteador',
    name: 'Sorteador',
    url: 'https://github.com/mateusrovedaa/sorteador',
    image: '/images/uploads/sorteador.png',
    description: 'Sistema de sorteio criado para o Tech Talks Day (Univates). API + frontend em TypeScript com Sequelize.',
    media: [],
  },
];
---

<BaseLayout title="Projetos" description="Projetos criados e mantidos por Mateus Roveda">
  <div data-pagefind-body>
  <PageHeader
    eyebrow="portfólio"
    title="Projetos"
    subtitle="Plataformas, ferramentas e iniciativas que ajudei a criar e manter."
  />

  <nav class="quick-links" aria-label="Acesso rápido">
    {projects.map(({ id, name }) => (
      <a href={`#${id}`}>{name}</a>
    ))}
  </nav>

  <div class="projects">
    {projects.map(({ id, name, url, image, description, media }, i) => (
      <section id={id} class="project">
        <div class="pj-head">
          <span class="pj-num">[{String(i + 1).padStart(2, '0')}]</span>
          <h2>
            <a href={url} target="_blank" rel="noopener noreferrer">{name} ↗</a>
          </h2>
        </div>
        <img src={image} alt={name} loading="lazy" />
        <p>{description}</p>
        {media.length > 0 && (
          <div class="media">
            <p class="media-title">Cobertura na imprensa</p>
            <ul>
              {media.map(({ label, url: mediaUrl }) => (
                <li><a href={mediaUrl} target="_blank" rel="noopener noreferrer">{label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))}
  </div>
  </div>
</BaseLayout>

<style>
  .quick-links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .quick-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-teal-mid);
    background: rgba(7, 126, 125, 0.08);
    border: 1px solid rgba(7, 126, 125, 0.2);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .quick-links a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .project {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: var(--space-xl);
  }

  .project:last-child {
    border-bottom: none;
  }

  .pj-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .pj-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
  }

  .project h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0;
  }

  .project h2 a {
    color: var(--text-strong);
    text-decoration: none;
    transition: color 0.15s;
  }

  .project h2 a:hover {
    color: var(--accent);
  }

  .project img {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    margin-bottom: var(--space-md);
    width: 100%;
    max-width: var(--content-width);
    height: auto;
    max-height: 360px;
    object-fit: cover;
    object-position: top;
  }

  .project p {
    line-height: 1.75;
    margin-bottom: var(--space-md);
    max-width: var(--content-width);
  }

  .media-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-teal-mid);
    margin-bottom: var(--space-sm);
  }
  .media-title::before { content: '// '; color: var(--accent); }

  .media ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .media a {
    font-size: 0.8rem;
    color: var(--color-blue-deep);
    background: rgba(0, 92, 254, 0.05);
    border: 1px solid rgba(0, 92, 254, 0.15);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .media a:hover {
    border-color: var(--color-blue-deep);
    text-decoration: none;
  }
</style>
