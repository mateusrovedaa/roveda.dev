---
import BaseLayout from '../layouts/BaseLayout.astro';

const quickLinks = [
  { label: 'GitHub', href: 'https://github.com/mateusrovedaa', icon: 'gh' },
  { label: 'GitLab', href: 'https://gitlab.com/mateusrovedaa', icon: 'gl' },
  { label: 'YouTube', href: 'https://youtube.com/ROVEEb', icon: 'yt' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mateusrovedaa/', icon: 'li' },
  { label: 'Instagram', href: 'https://www.instagram.com/mateusrovedaa/', icon: 'ig' },
  { label: 'Telegram', href: 'https://t.me/mateusrovedaa', icon: 'tg' },
  { label: 'WhatsApp', href: 'https://api.whatsapp.com/send?phone=5551995558131', icon: 'wa' },
  { label: 'E-mail', href: 'mailto:mateus@roveda.dev', icon: 'em' },
];

const experience = [
  {
    role: 'Analista DevOps',
    company: 'Instituto Todos pela Saúde (ITpS)',
    period: 'Abr 2024 – Presente',
    description: 'Infraestrutura confiável, automação e pipelines de dados para projetos internos e de clientes. Redução de 80% nos custos de treinamento de IA local e aumento de 10x na frequência de deploys.',
  },
  {
    role: 'Professor',
    company: 'Univates',
    period: 'Jan 2022 – Presente',
    description: 'Docência nos cursos Técnicos e na Graduação (POO, Web, Mobile).',
  },
  {
    role: 'Engenheiro DevOps e Líder de Infraestrutura',
    company: 'Criação .cc',
    period: 'Mar 2024 – Abr 2024',
    description: 'Infraestrutura para WordPress em escala: performance, alta disponibilidade e automação com Shell, Docker e CI/CD.',
  },
  {
    role: 'Administrador de Sistemas (DevOps)',
    company: 'Aztec Online Solutions',
    period: 'Set 2020 – Jan 2022',
    description: 'Administração de servidores GNU/Linux com foco em infraestrutura para WordPress: deploy, escalabilidade e automações com Shell e Docker.',
  },
];

const education = [
  {
    degree: 'Mestrado em Computação Aplicada',
    area: 'Simulação Computacional / Edge AI',
    institution: 'Unisinos',
    year: '2024 – Abr 2026',
  },
  {
    degree: 'Bacharelado em Engenharia de Software',
    area: '',
    institution: 'Univates',
    year: '2016 – 2023',
  },
];

const highlightedProjects = [
  { name: 'Pets RS', url: 'https://petsrs.com.br/', description: 'Plataforma oficial do RS para reencontro de animais nas enchentes de 2024.' },
  { name: 'Prefa Digital', url: 'https://prefa.digital', description: 'Soluções tecnológicas para prefeituras.' },
  { name: 'Universidade Brasileira Livre', url: 'https://ulivre.dev', description: 'Educação em TI em português, +10k estrelas no GitHub.' },
];
---

<BaseLayout
  title="Sobre"
  description="Sou Mateus Roveda, engenheiro DevOps, professor e criador de conteúdo sobre GNU/Linux e software livre."
>
  <div data-pagefind-body>
  <!-- Hero pessoal -->
  <section id="hero" class="hero">
    <img
      src="https://avatars.githubusercontent.com/u/22747307?s=400"
      alt="Foto de perfil de Mateus Roveda"
      class="avatar"
      loading="eager"
    />
    <div class="hero-text">
      <p class="page-eyebrow">~/sobre</p>
      <h1>Mateus Roveda</h1>
      <p class="tagline">Engenheiro DevOps · Professor · Software Livre</p>
      <nav class="quick-links" aria-label="Links de contato">
        {quickLinks.map(({ label, href }) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="quick-link">
            {label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Sobre - primeira pessoa -->
  <section id="sobre" class="section sobre-intro">
    <h2>~/sobre</h2>
    <p>
      Sou engenheiro DevOps, educador e pesquisador, há mais de oito anos construindo
      infraestrutura cloud, automação e back-end que precisa escalar de verdade. Especialista
      em containerização e CI/CD, já liderei entregas que cortaram <strong>80% do custo de infra para treino de IA</strong> e
      multiplicaram por <strong>10× a frequência de deploys</strong>.
    </p>
    <p>
      Mestre em Computação Aplicada (Edge&nbsp;AI) pela Unisinos, dou aula nos cursos Técnicos
      e na Graduação da Univates. Criei o canal ROVEEb e mantenho a
      Universidade Brasileira Livre. Acredito que conhecimento técnico bom é conhecimento
      aberto: em português, sem paywall. Sou movido por ensinar, software livre e, claro, pelo espaço.
    </p>
  </section>

  <!-- Experiência -->
  <section id="experiencia" class="section">
    <h2>Experiência</h2>
    <div class="timeline">
      {experience.map(({ role, company, period, description }) => (
        <div class="timeline-item">
          <div class="timeline-header">
            <strong>{role}</strong>
            <span class="company">{company}</span>
            <span class="period">{period}</span>
          </div>
          <p>{description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Formação -->
  <section id="formacao" class="section">
    <h2>Formação</h2>
    <div class="timeline">
      {education.map(({ degree, area, institution, year }) => (
        <div class="timeline-item">
          <div class="timeline-header">
            <strong>{degree}{area ? `, ${area}` : ''}</strong>
            <span class="company">{institution}</span>
            {year && <span class="period">{year}</span>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Certificações -->
  <section id="certificacoes" class="section">
    <h2>Certificações</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-header">
          <strong>LE 1: Linux Essentials</strong>
          <span class="company">LPI</span>
          <span class="period">ID: LPI000432981</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Artigos Publicados -->
  <section id="artigos" class="section">
    <h2>Artigos Publicados</h2>
    <p>
      Publicações acadêmicas disponíveis no Google Acadêmico.
    </p>
    <a
      href="https://scholar.google.com/citations?user=4T74HC4AAAAJ&hl=pt-BR"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-outline"
    >
      Ver no Google Acadêmico →
    </a>
  </section>

  <!-- Projetos em destaque -->
  <section id="projetos" class="section">
    <h2>Projetos em destaque</h2>
    <div class="project-cards">
      {highlightedProjects.map(({ name, url, description }) => (
        <a href={url} target="_blank" rel="noopener noreferrer" class="card project-card">
          <strong>{name}</strong>
          <p>{description}</p>
        </a>
      ))}
    </div>
    <a href="/projetos" class="btn-outline" style="margin-top: var(--space-md); display: inline-block;">
      Ver todos os projetos →
    </a>
  </section>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 3px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .hero-text h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    margin-bottom: var(--space-xs);
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .quick-link {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
    font-family: var(--font-mono);
  }

  .quick-link:hover {
    background-color: var(--surface-raised);
    border-color: var(--text-strong);
    color: var(--text-strong);
    text-decoration: none;
  }

  @media (max-width: 500px) {
    .hero {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .quick-links {
      justify-content: center;
    }
  }

  /* Sections */
  .section {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section:last-child {
    border-bottom: none;
  }

  .section h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-lg);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .section h2::before {
    content: '//';
    color: var(--text-muted);
  }

  .sobre-intro p {
    color: var(--text-body);
    font-size: 16px;
    line-height: 1.75;
    max-width: 60ch;
  }

  .section p {
    line-height: 1.75;
    margin-bottom: var(--space-md);
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .timeline-item {
    border-left: 2px solid var(--text-strong);
    padding-left: var(--space-md);
  }

  .timeline-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
    margin-bottom: var(--space-xs);
  }

  .timeline-header strong {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
  }

  .company {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .period {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 400;
  }

  .timeline-item p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  /* Project cards */
  .project-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .project-card {
    padding: var(--space-md);
  }

  .project-card strong {
    display: block;
    font-weight: var(--font-weight-bold);
    color: var(--text-strong);
    margin-bottom: var(--space-xs);
  }

  .project-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
