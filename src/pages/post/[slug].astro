---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatted = new Date(post.data.date).toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readMin = Math.max(
  1,
  Math.round((post.body ?? '').trim().split(/\s+/).filter(Boolean).length / 200)
);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <div class="read-progress" id="read-progress"></div>
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <p class="stat-cmd"><span class="p">$</span> stat {post.id}.md</p>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{dateFormatted}</time>
        {post.data.categorias && post.data.categorias.length > 0 && (
          <div class="post-categories">
            {post.data.categorias.map((cat) => (
              <span class="cat-tag">{cat}</span>
            ))}
          </div>
        )}
        <span class="readtime">~{readMin} min de leitura</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.author && <p class="author">por {post.data.author}</p>}
    </header>

    <div class="post-content">
      <Content />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <footer class="post-tags">
        {post.data.tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </footer>
    )}
  </article>

  <script is:inline>
    (function () {
      var bar = document.getElementById('read-progress');
      if (!bar) return;
      var doc = document.documentElement;
      function upd() {
        var max = doc.scrollHeight - doc.clientHeight;
        bar.style.width = (max > 0 ? (doc.scrollTop / max) * 100 : 0) + '%';
      }
      addEventListener('scroll', upd, { passive: true });
      addEventListener('resize', upd);
      upd();
    })();
  </script>
</BaseLayout>

<style>
  .post {
    max-width: 100%;
  }

  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--accent);
    z-index: 101;
    transition: width 0.05s linear;
  }

  .post-header {
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-lg);
  }

  .stat-cmd {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }
  .stat-cmd .p { color: var(--color-teal-mid); font-weight: 700; }

  .readtime {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  time {
    font-size: 0.85rem;
    font-weight: var(--font-weight-light);
    color: var(--text-muted);
  }

  .post-categories {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-strong);
    margin-bottom: var(--space-sm);
  }

  .author {
    font-size: 0.9rem;
    font-weight: var(--font-weight-light);
    color: var(--text-muted);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    font-weight: var(--font-weight-bold);
    margin: var(--space-xl) 0 var(--space-md);
    color: var(--text-strong);
  }

  .post-content :global(h1) { font-size: 1.75rem; }
  .post-content :global(h2) { font-size: 1.4rem; }
  .post-content :global(h3) { font-size: 1.15rem; }

  /* prefixo markdown ## nas headings de conteúdo */
  .post-content :global(h2),
  .post-content :global(h3) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }
  .post-content :global(h2)::before { content: '##'; }
  .post-content :global(h3)::before { content: '###'; }
  .post-content :global(h2)::before,
  .post-content :global(h3)::before {
    font-family: var(--font-mono);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.7em;
  }

  .post-content :global(p) {
    margin-bottom: var(--space-md);
    line-height: 1.75;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: var(--space-md) 0 var(--space-md) var(--space-lg);
    line-height: 1.75;
  }

  .post-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .post-content :global(pre) {
    position: relative;
    background-color: var(--color-dark);
    color: var(--color-teal-light);
    border: 1px solid rgba(65, 186, 255, 0.18);
    padding: 2.7rem var(--space-md) var(--space-md);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-lg) 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* barra de "janela de terminal" no topo do bloco de código */
  .post-content :global(pre)::before {
    content: '\25CF \25CF \25CF';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 0.5rem 0.9rem;
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    color: rgba(178, 228, 255, 0.42);
    background: rgba(65, 186, 255, 0.06);
    border-bottom: 1px solid rgba(65, 186, 255, 0.14);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .post-content :global(code) {
    background-color: var(--color-blue-light);
    color: var(--color-teal-dark);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.875em;
  }

  .post-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent-highlight);
    padding-left: var(--space-md);
    margin: var(--space-md) 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-content :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-md) 0;
  }

  .post-content :global(a) {
    color: var(--color-blue-deep);
    text-decoration: underline;
  }

  .post-content :global(iframe) {
    border-radius: var(--radius-md);
    margin: var(--space-lg) 0;
    max-width: 100%;
  }

  .post-tags {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8rem;
    font-weight: var(--font-weight-light);
    color: var(--text-muted);
  }
</style>
