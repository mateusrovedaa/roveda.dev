---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestVideos } from '../lib/youtube';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = sorted[0];
const rest = sorted.slice(1, 5);

const videos = await getLatestVideos(3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
const fmtShort = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).replace(' de ', ' ').replace('.', '');
const fmtVideoDate = (iso: string) =>
  new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
const readMin = (body?: string) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));
---

<BaseLayout
  title="Tutoriais, ideias e ferramentas"
  fullTitleOverride="Roveda: Tutoriais, ideias e ferramentas"
  description="Por Mateus Roveda, escrevo e gravo sobre DevOps, GNU/Linux e software livre. Tutoriais e ferramentas em português, abertos para todas as pessoas."
>
  <div class="stack">

    <!-- Canal - dados reais via YouTube RSS (build-time) -->
    <section id="canal" class="sec-canal">
      <div class="sec-head">
        <h2>~/canal</h2>
        <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer" class="sec-link">youtube.com/ROVEEb ↗</a>
      </div>
      <div class="canal-grid">
        {videos.map((v, i) => (
          <a
            href={v.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['video-card', { 'video-card--featured': i === 0 }]}
            data-video-id={v.id}
            data-video-title={v.title}
            aria-label={`Assistir ${v.title} no YouTube`}
          >
            <div class="vc-thumb">
              <img src={v.thumbnail} alt="" loading="lazy" class="vc-img" width="320" height="180" />
              <div class="vc-overlay"></div>
              <span class="vc-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="11" fill="rgba(0,0,0,0.55)" stroke="rgba(255,255,255,0.9)" stroke-width="1"></circle><path d="M10 8.5 L16 12 L10 15.5 Z" fill="#FFFFFF"></path></svg>
              </span>
              <div class="vc-info">
                <span class="vc-title">{v.title}</span>
                <span class="vc-date">{fmtVideoDate(v.published)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div id="video-modal" class="video-modal">
      <div class="vm-backdrop" data-close></div>
      <div class="vm-dialog" role="dialog" aria-modal="true" aria-label="Reprodutor de vídeo">
        <button type="button" class="vm-close" data-close aria-label="Fechar vídeo">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6 L18 18 M18 6 L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
        <div class="vm-frame-wrap">
          <iframe id="video-modal-iframe" class="vm-iframe" src="" title="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        </div>
      </div>
    </div>

    <!-- Artigos -->
    <section id="artigos" class="sec-articles">
      <div class="sec-head">
        <h2>~/artigos</h2>
        <a href="/posts" class="sec-link">todos →</a>
      </div>

      {featured && (
        <a href={`/post/${featured.id}`} class="feat-card">
          <div class="feat-meta">último artigo · {fmtDate(featured.data.date)} · ~{readMin(featured.body)} min</div>
          <h3 class="feat-title">{featured.data.title}</h3>
          {featured.data.description && <p class="feat-desc">{featured.data.description}</p>}
          <div class="feat-foot">
            <span class="feat-tags">
              {(featured.data.categorias?.slice(0, 2) ?? ['geral']).map((c) => (
                <span class="mini-tag">{c}</span>
              ))}
            </span>
            <span class="feat-cta">ler →</span>
          </div>
        </a>
      )}

      <div class="post-rows">
        {rest.map((post) => (
          <a href={`/post/${post.id}`} class="row">
            <span class="row-date">{fmtShort(post.data.date)}</span>
            <span class="row-main">
              <span class="row-title">{post.data.title}</span>
              {post.data.categorias?.[0] && <span class="row-tag">{post.data.categorias[0]}</span>}
            </span>
            <span class="row-arrow">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Sobre - primeira pessoa -->
    <section id="sobre" class="sec-sobre">
      <div class="sobre-text">
        <h2>~/sobre</h2>
        <p>Sou engenheiro DevOps, educador e pesquisador, há mais de oito anos entre infra cloud, automação e back-end. Especialista em containerização e CI/CD, já cortei 80% de custo de infra de IA e multipliquei deploys por 10×.</p>
        <p>Mestre em Computação Aplicada (Edge&nbsp;AI) pela Unisinos, dou aula nos cursos Técnicos e na Graduação da Univates, criei o canal ROVEEb e mantenho a UBLivre. Acredito em conhecimento aberto: em português, sem paywall.</p>
        <a href="/sobre" class="more-link">conheça minha trajetória →</a>
      </div>
      <div class="sobre-card">
        <div class="sc-head">
          <svg viewBox="0 0 100 100" width="40" height="40" aria-hidden="true">
            <path d="M32 86 V14 H54 A17 17 0 0 1 54 48 H32 M52 48 L72 86" fill="none" stroke="#92FDEF" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="71" cy="31" r="7.5" fill="#92FDEF"></circle>
            <circle cx="32" cy="86" r="8" class="sc-ring" stroke="#92FDEF" stroke-width="5"></circle>
            <circle cx="72" cy="86" r="8" class="sc-ring" stroke="#EFFEFC" stroke-width="5"></circle>
          </svg>
          <strong class="sc-name">Roveda</strong>
        </div>
        <div class="sc-links">
          <a href="https://github.com/mateusrovedaa" target="_blank" rel="noopener noreferrer"><span>github</span><span>mateusrovedaa ↗</span></a>
          <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer"><span>youtube</span><span>ROVEEb ↗</span></a>
          <a href="https://www.linkedin.com/in/mateusrovedaa/" target="_blank" rel="noopener noreferrer"><span>linkedin</span><span>mateusrovedaa ↗</span></a>
          <a href="mailto:mateus@roveda.dev"><span>email</span><span>mateus@roveda.dev</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var modal = document.getElementById('video-modal');
    var cards = document.querySelectorAll('[data-video-id]');
    if (!modal || !cards.length) return;
    var iframe = document.getElementById('video-modal-iframe');
    var closeBtn = modal.querySelector('.vm-close');
    var lastTrigger = null;

    function openModal(videoId, title) {
      lastTrigger = document.activeElement;
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
      iframe.title = title || 'Vídeo do YouTube';
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      if (!modal.classList.contains('is-open')) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      iframe.src = '';
      if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
    }

    modal.querySelectorAll('[data-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        var videoId = card.getAttribute('data-video-id');
        if (!videoId) return;
        e.preventDefault();
        openModal(videoId, card.getAttribute('data-video-title'));
      });
    });
  })();
</script>

<style>
  .stack {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 0 96px;
    display: flex;
    flex-direction: column;
    gap: 88px;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
    gap: 16px;
  }
  .sec-head h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--text-strong);
  }
  .sec-link {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
  }
  .sec-link:hover { color: var(--text-strong); text-decoration: underline; text-underline-offset: 3px; }

  /* Featured - P&B caixa branca borda fina */
  .feat-card {
    display: block;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 28px 28px;
    color: var(--text-strong);
    text-decoration: none;
    margin-bottom: 34px;
    transition: border-color 0.15s;
  }
  .feat-card:hover { border-color: var(--text-strong); text-decoration: none; }
  .feat-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .feat-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 680px;
    text-wrap: pretty;
    color: var(--text-strong);
    margin-bottom: 10px;
  }
  .feat-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 640px;
    margin-bottom: 18px;
  }
  .feat-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .mini-tag {
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    color: var(--text-body);
  }
  .feat-cta { margin-left: auto; color: var(--text-strong); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-subtle); }
  .feat-card:hover .feat-cta { text-decoration-color: var(--text-strong); }

  /* Rows - P&B */
  .post-rows { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 20px 6px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-strong);
    text-decoration: none;
    transition: background 0.15s;
  }
  .row:hover { background: var(--surface-highlight); text-decoration: none; }
  .row-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .row-main { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .row-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .row-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .row-arrow { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); }
  .row:hover .row-arrow { color: var(--text-strong); }

  /* Canal - featured 2col + 2 menores */
  .canal-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
  }
  .video-card--featured {
    grid-row: 1 / 3;
  }
  .video-card--featured .vc-thumb {
    height: 100%;
    min-height: 300px;
  }
  .video-card {
    display: flex;
    flex-direction: column;
    color: var(--text-strong);
    text-decoration: none;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: #0A0A0A;
    position: relative;
    transition: border-color 0.15s;
  }
  .video-card:hover,
  .video-card:focus-visible {
    border-color: var(--text-strong);
    text-decoration: none;
  }
  .video-card:hover .vc-img,
  .video-card:focus-visible .vc-img {
    transform: scale(1.06);
  }
  .video-card:hover .vc-play,
  .video-card:focus-visible .vc-play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .video-card:hover .vc-img { transform: none; }
  }
  .vc-thumb {
    aspect-ratio: 16/9;
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    background: #0A0A0A;
    flex: 1;
  }
  .video-card--featured .vc-thumb { aspect-ratio: auto; }
  .vc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .vc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.68) 100%);
  }
  .vc-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    line-height: 0;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.85);
    transition: opacity 0.2s ease, transform 0.2s ease;
    filter: drop-shadow(0 1px 6px rgba(0,0,0,0.45));
  }
  @media (prefers-reduced-motion: reduce) {
    .vc-play { transition: opacity 0.2s ease; transform: translate(-50%, -50%) scale(1); }
  }
  .vc-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .vc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.3;
    text-shadow: 0 1px 8px rgba(0,0,0,0.6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-card--featured .vc-title { font-size: 18px; -webkit-line-clamp: 3; }
  .vc-date {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(237, 237, 237, 0.68);
  }

  /* Modal do player de vídeo */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .video-modal.is-open { opacity: 1; pointer-events: auto; }
  .vm-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }
  .vm-dialog {
    position: relative;
    width: 100%;
    max-width: 960px;
  }
  .vm-close {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    color: #FFFFFF;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .vm-close:hover { border-color: #FFFFFF; }
  .vm-frame-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000000;
    border-radius: 10px;
    overflow: hidden;
  }
  .vm-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 640px) {
    .video-modal { padding: 16px; }
    .vm-close { top: -40px; }
  }

  /* Sobre - P&B */
  .sec-sobre {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .sobre-text h2 {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--text-strong);
  }
  .sobre-text p {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-body);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .more-link {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-subtle);
    font-weight: 700;
  }
  .more-link:hover { text-decoration-color: var(--text-strong); }

  .sobre-card {
    background: #0A0A0A;
    color: #EDEDED;
    border: 1px solid #0A0A0A;
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  :global(html[data-theme='dark']) .sobre-card {
    background: #1C1C1C;
    border-color: #383838;
  }
  .sc-head {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #EDEDED;
  }
  .sc-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: #FFFFFF;
  }
  .sc-ring { fill: #0A0A0A; }
  :global(html[data-theme='dark']) .sc-ring { fill: #1C1C1C; }
  .sobre-card > .sc-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 12px;
  }
  :global(html[data-theme='dark']) .sobre-card > .sc-links { border-top-color: #3A3A3A; }
  .sc-links a {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #EDEDED;
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }
  .sc-links a span:last-child { color: #B8B8B8; }
  .sc-links a:hover { color: #FFFFFF; }
  .sc-links a:hover span:last-child { color: #FFFFFF; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 900px) {
    .canal-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .video-card--featured { grid-row: auto; }
    .video-card--featured .vc-thumb { min-height: auto; aspect-ratio: 16/9; }
    .sec-sobre { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .stack { gap: 56px; padding-top: 16px; padding-bottom: 48px; }
    .row { grid-template-columns: 1fr auto; gap: 12px; }
    .row-date { grid-column: 1 / -1; }
    .feat-card { padding: 22px 20px; }
    .feat-title { font-size: 21px; }
  }
</style>
