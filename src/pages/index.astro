---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const projects = [
  {
    icon: '🐾',
    name: 'Pets RS',
    desc: 'Plataforma oficial RS para resgate de animais nas enchentes de 2024',
    tags: ['GovTech', 'Open Source'],
    url: 'https://petsrs.com.br/',
  },
  {
    icon: '🏙️',
    name: 'Prefa Digital',
    desc: 'Plataforma de GovTech para cidades inteligentes e gestão pública',
    tags: ['Smart Cities', 'SaaS'],
    url: 'https://prefa.digital',
  },
  {
    icon: '📚',
    name: 'UBL',
    desc: 'Universidade Brasileira Livre — educação open source com 10k+ estrelas',
    tags: ['Educação', 'Open Source'],
    url: 'https://ulivre.dev',
  },
];
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <p class="hero-eyebrow">$ whoami</p>
        <h1>Mateus <span class="accent">Roveda</span></h1>
        <p class="hero-bio">
          Engenheiro DevOps · Professor · Mestre em Edge AI.<br />
          Escrevo sobre infraestrutura, automação e software livre.
        </p>
        <nav class="hero-links">
          <a href="/posts">Posts</a>
          <a href="/projetos">Projetos</a>
          <a href="/sobre">Sobre</a>
          <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer">YouTube ↗</a>
        </nav>
      </div>

      <div class="hero-right">
        <div class="terminal-card">
          <div class="terminal-bar">
            <span class="terminal-title">mateus@roveeb:~</span>
            <div class="terminal-controls">
              <span class="wm-btn">−</span>
              <span class="wm-btn">×</span>
            </div>
          </div>
          <div class="terminal-body">
            <p><span class="prompt">$</span> cat about.txt</p>
            <p class="out">Engenheiro DevOps · ITpS</p>
            <p class="out">Professor · Univates</p>
            <p class="out">Mestre em Edge AI · Unisinos</p>
            <p class="out">Youtuber · youtube.com/ROVEEb</p>
            <p class="out">Lider · Universidade Brasileira Livre</p>
            <br />
            <p><span class="prompt">$</span> ls stack/</p>
            <p class="out comment">Kubernetes  Docker  Terraform</p>
            <p class="out comment">GitLab-CI  Python  NGINX  Linux</p>
            <br />
            <p><span class="prompt">$</span> <span class="cursor">▋</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Posts recentes -->
  <section class="section">
    <header class="section-header">
      <h2 class="section-heading">Posts recentes</h2>
      <a href="/posts" class="section-more">Ver todos →</a>
    </header>
    <div class="posts-grid">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Projetos -->
  <section class="section">
    <header class="section-header">
      <h2 class="section-heading">Projetos</h2>
      <a href="/projetos" class="section-more">Ver todos →</a>
    </header>
    <div class="projects-grid">
      {projects.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="card project-card">
          <span class="project-icon">{p.icon}</span>
          <div class="project-body">
            <p class="project-name">{p.name}</p>
            <p class="project-desc">{p.desc}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="project-tag">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Comunidade -->
  <section class="section community-section">
    <h2 class="section-heading">Comunidade</h2>
    <div class="community-row">
      <a href="https://youtube.com/ROVEEb" target="_blank" rel="noopener noreferrer" class="community-card youtube">
        <span class="community-icon">▶</span>
        <div>
          <strong>YouTube</strong>
          <span>ROVEEb · 8k+ inscritos</span>
        </div>
      </a>
      <a href="https://t.me/roveeb" target="_blank" rel="noopener noreferrer" class="community-card telegram">
        <span class="community-icon">✈</span>
        <div>
          <strong>Telegram</strong>
          <span>@roveeb</span>
        </div>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    background: var(--gradient-hero);
    border-radius: var(--radius-lg);
    padding: 3rem var(--space-xl);
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-teal-light);
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .accent { color: var(--color-primary); }

  .hero-bio {
    color: rgba(255, 255, 255, 0.75);
    font-weight: var(--font-weight-light);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .hero-links {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.04em;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.15s, color 0.15s;
  }

  .hero-links a:hover {
    opacity: 1;
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ─── Terminal ─── */
  .terminal-card {
    background: #0a1929;
    border: 1px solid rgba(65, 186, 255, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .terminal-bar {
    background: #162032;
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid rgba(65, 186, 255, 0.1);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(178, 228, 255, 0.6);
  }

  .terminal-controls {
    display: flex;
    gap: 0.35rem;
  }

  .wm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid rgba(178, 228, 255, 0.2);
    border-radius: 3px;
    font-size: 0.7rem;
    line-height: 1;
    color: rgba(178, 228, 255, 0.4);
    cursor: default;
    user-select: none;
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--color-blue-light);
  }

  .terminal-body .prompt { color: var(--color-teal-light); margin-right: 0.5rem; font-weight: 700; }
  .terminal-body .out    { color: rgba(178, 228, 255, 0.7); padding-left: 1.2rem; }
  .terminal-body .comment { color: var(--color-teal-mid); }

  .cursor { color: var(--color-primary); animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* ─── Sections ─── */
  .section { margin-bottom: 3rem; }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .section-header .section-heading { margin-bottom: 0; }

  .section-more {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .section-more:hover { text-decoration: underline; }

  /* ─── Projetos ─── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .project-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.25rem;
  }

  .project-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .project-body { min-width: 0; }

  .project-name {
    font-size: 0.95rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-dark);
    margin-bottom: 0.3rem;
  }

  .project-desc {
    font-size: 0.78rem;
    color: var(--color-gray);
    line-height: 1.5;
    margin-bottom: 0.65rem;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(65, 186, 255, 0.08);
    border: 1px solid rgba(65, 186, 255, 0.2);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }

  /* ─── Comunidade ─── */
  .community-section { margin-bottom: 4rem; }

  .community-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .community-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: #ffffff;
    background: var(--gradient-hero);
    transition: opacity 0.15s;
  }

  .community-card.youtube  { border: 1px solid rgba(255, 0, 0, 0.25); }
  .community-card.telegram { border: 1px solid rgba(65, 186, 255, 0.25); }

  .community-card:hover { opacity: 0.88; text-decoration: none; }

  .community-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .youtube  .community-icon { background: #ff0000; }
  .telegram .community-icon { background: var(--color-primary); color: var(--color-dark); }

  .community-card strong { display: block; font-size: 0.9rem; font-weight: var(--font-weight-bold); }
  .community-card span   { font-size: 0.75rem; font-weight: var(--font-weight-light); color: rgba(255,255,255,0.55); font-family: var(--font-mono); }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .hero-inner    { grid-template-columns: 1fr; }
    .hero-right    { display: none; }
    .projects-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .hero { padding: var(--space-lg); }
    .projects-grid, .community-row { grid-template-columns: 1fr; }
  }
</style>
