---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<BaseLayout
  title="Liberdade de conhecimentos"
  fullTitleOverride="ROVEEb - Liberdade de conhecimentos"
  description="Blog & canal sobre IA, DevOps, GNU/Linux e software livre. Tutoriais, ideias e ferramentas — em português, abertos a todos. Por Mateus Roveda."
>
  <!-- Hero -->
  <section class="hero">
    <p class="eyebrow"><span class="d">//</span> ROVEEb — Comunidade</p>
    <h1>IA, DevOps, GNU/Linux e <span class="accent">Software livre.</span></h1>
    <p class="sub"><b>Tutoriais</b>, ideias e ferramentas — em português, abertos a todos.</p>
  </section>

  <!-- Posts -->
  <section class="posts">
    <div class="sec-h">
      <h2 class="sec-t"><span class="d">//</span> últimos posts</h2>
      <a class="sec-all" href="/posts">ver todos →</a>
    </div>
    <PostList posts={posts} featured />
  </section>
</BaseLayout>

<style>
  /* ─── Hero enxuto, tipografia grossa ─── */
  .hero { padding: 3.5rem 0 5.5rem; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.6rem;
  }
  .eyebrow .d { color: var(--accent); }

  .hero h1 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 18ch;
    color: var(--text-strong);
  }
  .hero h1 .accent { color: var(--accent); }

  .hero .sub {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--text-muted);
    margin-top: 1.75rem;
  }
  .hero .sub b { color: var(--color-teal-mid); font-weight: 500; }

  /* ─── Posts ─── */
  .posts { padding-bottom: 3rem; }

  .sec-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.1rem;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--text-strong);
  }
  .sec-t {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-strong);
  }
  .sec-t .d { color: var(--accent); }
  .sec-all {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .sec-all:hover { text-decoration: underline; }
</style>
